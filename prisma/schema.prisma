// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  ahorros       Ahorro[]
  ingresos      Ingreso[]
  gastosFijos   GastoFijo[]
  gastosDiarios GastoDiario[]
  categoriasGastoDiario CategoriaGastoDiario[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ahorro {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  nombre    String
  monto     Float
  categoria String
  fecha     DateTime
  objetivo  Float?
  icono     String?
  user      User     @relation(fields: [userId], references: [id])
}

model Ingreso {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  nombre    String
  monto     Float
  categoria String
  fecha     DateTime
  recibido  Boolean
  user      User     @relation(fields: [userId], references: [id])
}

model GastoFijo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  nombre    String
  monto     Float
  categoria String
  fechaPago DateTime
  cubierto  Boolean
  cuotas    Int?
  user      User     @relation(fields: [userId], references: [id])
}

model GastoDiario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  nombre    String
  monto     Float
  categoria String
  fecha     DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model CategoriaGastoDiario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
}
